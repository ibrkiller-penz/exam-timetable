{
  "name": "exam-timetable",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:local": "npm run build && node scripts/deploy-local.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/react-virtual": "^3.13.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.1",
    "immer": "^10.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.475.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "main": "public/electron.cjs",
  "build": {
    "appId": "com.examtimetable.app",
    "productName": "시험시간표",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "public/electron.cjs",
      "public/preload.cjs"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}_설치파일.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "시험시간표"
    },
    "forceCodeSigning": false
  }
}
