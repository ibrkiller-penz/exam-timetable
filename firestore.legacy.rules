// school-schedule-ad811 의 원래 규칙입니다.
//
// 그 프로젝트에는 급식·출결 등 다른 프로그램이 다섯 개 얹혀 있고, 모두 이
// 규칙 아래에서 돌아갑니다. 고사시간표를 전용 프로젝트(examtable-app)로
// 떼어 내면서, 그 프로젝트는 건드리기 전 상태로 되돌려 놓습니다.
//
//   npx firebase deploy --only firestore:rules --project school-schedule-ad811 --config firebase.legacy.json
//
// 주의: 이 규칙은 누구나 읽고 쓸 수 있습니다. 그 프로그램들도 언젠가
// 고사시간표처럼 각자의 열쇠(또는 로그인)를 두어야 합니다.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
